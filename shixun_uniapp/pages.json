{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				// 讲义 §11 这里留的是模板默认的 "uni-app"，但底部 tabBar 和 globalStyle
				// 都写的是「校园帮」，导航栏显示 uni-app 太出戏，统一成校园帮
				"navigationBarTitleText": "校园帮"
			}
		},
		{
			"path": "pages/auth/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/auth/register",
			"style": {
				"navigationBarTitleText": "注册"
			}
		},
		{
			"path": "pages/order/create",
			"style": {
				"navigationBarTitleText": "发布订单"
			}
		},
		{
			"path": "pages/order/list",
			"style": {
				"navigationBarTitleText": "订单列表",
				// 报告模板「实训内容 2(1)」点名订单列表要有下拉刷新 + 上拉加载分页。
				// 下拉刷新由这个开关控制（页面里的 onPullDownRefresh 不配它就永远不触发）；
				// 上拉加载不需要开关，到底部会自动触发 onReachBottom。
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/order/detail",
			"style": {
				"navigationBarTitleText": "订单详情",
				// 讲义没写这行：detail.vue 里定义了 onPullDownRefresh，
				// 不开这个开关下拉刷新不会触发
				"enablePullDownRefresh": true
			}
		},
		{
			// 订单聊天。对应需求「移动端前台功能 1、聊天界面」：
			// 接单之后发布者和跑腿员在这条通道里沟通，从订单详情页的「联系对方」进入。
			// 管理端仲裁时看到的是同一段对话（3.5.3 的「查看聊天记录」）
			"path": "pages/order/chat",
			"style": {
				"navigationBarTitleText": "订单聊天"
			}
		},
		{
			// 考核作业「个人中心」。讲义 Part A 的项目结构树里列了这个文件名
			// （pages/user/profile.vue），但没给页面代码，页面是后写的
			"path": "pages/user/profile",
			"style": {
				"navigationBarTitleText": "个人中心"
			}
		},
		{
			// AI 会话页。讲义「5-2 流式对话与角色预设」只给了后端接口，
			// 没有前端页面，这个页面是按那一节的接口自己接的
			"path": "pages/ai/chat",
			"style": {
				"navigationBarTitleText": "AI 助手"
			}
		},
		{
			// 个人钱包。对应需求「移动端前台功能 5、个人钱包【交易记录、提现、充值】」，
			// 从个人中心页进入
			"path": "pages/wallet/wallet",
			"style": {
				"navigationBarTitleText": "我的钱包"
			}
		},
		{
			// 实名认证提交页。对应需求 3.5.1 用户管理的认证部分，
			// 提交后进管理端「认证审核」队列，从个人中心页进入
			"path": "pages/user/verify",
			"style": {
				"navigationBarTitleText": "实名认证"
			}
		}
	],
	"tabBar": {
		"color": "#64748b",
		"selectedColor": "#6366f1",
		"backgroundColor": "#0f172a",
		"borderStyle": "black",
		"list": [{
			"pagePath": "pages/index/index",
			"text": "首页"
		}, {
			"pagePath": "pages/order/list",
			"text": "订单广场"
		}, {
			// 考核作业要求新增的 tabBar 项
			"pagePath": "pages/user/profile",
			"text": "个人中心"
		}]
	},
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "校园帮",
		"navigationBarBackgroundColor": "#0f172a",
		"backgroundColor": "#0f172a",
		"backgroundTextStyle": "dark"
	},
	"uniIdRouter": {}
}
