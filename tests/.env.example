# 跑 pytest 前把本文件复制成 tests/.env 并填上自己的值。
# tests/.env 已被 .gitignore 忽略，不会进版本库。
#
# 这两个值 conftest.py 会读——缺任何一个都会在收集用例阶段直接报错，
# 不会给你一个默认口令顶着用。仓库是公开的，默认口令等于没改。
#
# 不想建文件的话，也可以先 export 再跑（环境变量优先）：
#   export DB_PASSWORD=... ADMIN_PASSWORD=...
#   pytest tests/ -v

# 本机 MySQL 的 root 口令（和 application.yml 的 DB_PASSWORD 是同一个值）
DB_PASSWORD=your-mysql-password

# 管理员账号的口令。账号在 adminLogin 里按 real_name 查，名字见 conftest.py 的 ADMIN_NAME。
# 跑 shixun 那个 Java 测试类（OrdersApiTest）也要这个变量，同一个值。
ADMIN_PASSWORD=your-admin-password

# campus.sql 种子里那两个演示账号（2021001001 张同学 / 2020002001 快递小哥小陈）
# 的口令。给 test_messages.py 用。库里存的是 bcrypt 哈希，所以明文只有本机知道。
DEMO_PASSWORD=your-demo-password
